{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "plum", "name": "Plum", "color": "#8D0452" },
				{ "slug": "plum-700", "name": "Plum deep", "color": "#6E0340" },
				{ "slug": "plum-900", "name": "Plum night", "color": "#3A0222" },
				{ "slug": "paper", "name": "Off-white", "color": "#FBF8F4" },
				{ "slug": "sand", "name": "Sand", "color": "#F1EAE3" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink", "color": "#1D1418" },
				{ "slug": "ink-soft", "name": "Ink soft", "color": "#5F5359" },
				{ "slug": "line", "name": "Line", "color": "#E6DED7" }
			]
		},
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1440px"
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 6vw, 5rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(4.5rem, 9vw, 7rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "dm-sans",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/dm-sans-latin-wght-normal.woff2" ]
						}
					]
				},
				{
					"slug": "barlow-condensed",
					"name": "Barlow Condensed",
					"fontFamily": "\"Barlow Condensed\", \"Arial Narrow\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-condensed-latin-500-normal.woff2" ]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-condensed-latin-600-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.125rem", "fluid": false },
				{ "slug": "x-large", "name": "Extra large", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "xx-large", "name": "Section title", "size": "3.25rem", "fluid": { "min": "2.125rem", "max": "3.25rem" } },
				{ "slug": "display", "name": "Display", "size": "4.5rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|dm-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"bottom": "0px",
				"left": "clamp(20px, 5.5vw, 96px)",
				"right": "clamp(20px, 5.5vw, 96px)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|plum" },
				":hover": { "color": { "text": "var:preset|color|plum-700" } }
			},
			"heading": {
				"typography": {
					"fontWeight": "400",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				},
				"color": { "text": "var:preset|color|ink" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|display" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large", "fontWeight": "500" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large", "fontWeight": "600" } },
			"button": {
				"color": {
					"background": "var:preset|color|plum",
					"text": "var:preset|color|white"
				},
				"border": { "radius": "999px" },
				"typography": { "fontSize": "15px", "fontWeight": "500", "lineHeight": "1.2" },
				"spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "24px", "right": "24px" } },
				":hover": { "color": { "background": "var:preset|color|plum-700", "text": "var:preset|color|white" } },
				":focus": { "outline": { "color": "var:preset|color|plum", "offset": "3px", "style": "solid", "width": "2px" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontSize": "17px", "fontWeight": "600", "letterSpacing": "0.3em", "textTransform": "uppercase" },
				"elements": { "link": { "color": { "text": "inherit" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "13.5px" }
			},
			"core/quote": {
				"border": { "width": "0px" },
				"typography": { "fontSize": "1.25rem" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "area": "header", "title": "Header" },
		{ "name": "header-overlay", "area": "header", "title": "Header over hero" },
		{ "name": "footer", "area": "footer", "title": "Footer" }
	],
	"customTemplates": [
		{ "name": "page-full", "title": "Designed page (full width, no title)", "postTypes": [ "page" ] }
	]
}
